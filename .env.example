APP_NAME="OT Pre-Surgical Safety Gate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ot_safety_gate
DB_USERNAME=ot_user
DB_PASSWORD=ot_secret
DB_ROOT_PASSWORD=root_secret

# ─── HAPI FHIR Server ────────────────────────────────────────────────────────
FHIR_BASE_URL=http://hapi-fhir:8080/fhir

# ─── SMART on FHIR OAuth ─────────────────────────────────────────────────────
SMART_CLIENT_ID=ot-safety-gate-local
SMART_REDIRECT_URI=http://localhost/smart/callback
SMART_SCOPE="openid fhirUser launch patient/*.read"
SMART_AUTHORIZE_URL=http://localhost:8080/fhir/smart/authorize
SMART_TOKEN_URL=http://localhost:8080/fhir/smart/token

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ─── Vite / Frontend ─────────────────────────────────────────────────────────
VITE_APP_URL="${APP_URL}"
